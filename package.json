{
  "name": "worshipdeck",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "clean": "node -e \"for (const dir of ['dist', 'dist-electron']) require('fs').rmSync(dir, { recursive: true, force: true })\"",
    "build:mac": "npm run clean && tsc && vite build && npm run import:bible -- --bundle && electron-builder --mac --publish never",
    "build:win": "npm run clean && tsc && vite build && npm run import:bible -- --bundle && electron-builder --win --publish never",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "preview": "vite preview",
    "import:bible": "node scripts/import-bible.ts",
    "fetch:whisper": "node scripts/fetch-whisper.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.48.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^38.8.6",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^3.2.7"
  },
  "main": "dist-electron/main.js",
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild@0.21.5": true,
    "better-sqlite3@13.0.3": true,
    "fsevents@2.3.3": true
  }
}
